{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        "username": { ".write": "auth != null && auth.uid === $uid", ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 30 && !newData.val().matches(/[<>\"'`&\\\\]/)" },
        "phone":    { ".write": "auth != null && auth.uid === $uid", ".validate": "newData.isString() && newData.val().length <= 16 && newData.val().matches(/^[0-9+]*$/)" }
      }
    },

    "categories":   { ".read": true, ".write": "auth.token.admin === true" },
    "matches":      { ".read": true, ".write": "auth.token.admin === true", ".indexOn": ["status", "category"] },
    "app_settings": { ".read": true, ".write": "auth.token.admin === true" },
    "notifications": { ".read": "auth != null", ".write": "auth.token.admin === true" },

    "match_participants": { ".read": "auth != null", ".write": false },
    "match_joined":  { ".read": "auth.token.admin === true", ".write": false },
    "match_secrets": {
      ".read": "auth.token.admin === true",
      ".write": "auth.token.admin === true",
      "$mid": { ".read": "auth != null && root.child('match_joined').child($mid).child(auth.uid).val() === true" }
    },

    "transactions": {
      ".read": "auth.token.admin === true",
      "$uid": { ".read": "auth != null && auth.uid === $uid", ".indexOn": ["ts"] }
    },
    "withdraw_requests": { ".read": "auth.token.admin === true", ".write": false, ".indexOn": ["status"] },
    "sms_inbox":      { ".read": "auth.token.admin === true", ".write": false, ".indexOn": ["receivedAt"] },
    "deposit_claims": { ".read": "auth.token.admin === true", ".write": false },
    "apiKeys":        { ".read": "auth.token.admin === true", ".write": "auth.token.admin === true" },
    "audit":          { ".read": "auth.token.admin === true", ".write": false },
    "config":         { ".read": false, ".write": false },
    "rate":           { ".read": false, ".write": false }
  }
}
